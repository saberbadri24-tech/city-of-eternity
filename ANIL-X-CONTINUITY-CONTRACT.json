{
  "schemaVersion": 1,
  "systemName": "ANIL X",
  "canonicalIdentity": {
    "site": "ANIL X",
    "guard": "Immortal Guard",
    "guardRole": "Super Airdrop",
    "guardIsSeparateProduct": false,
    "guardAliases": [
      "Immortal Guard",
      "Guard جاویدان",
      "جاویدان"
    ],
    "canonicalRuntimeName": "Immortal Guard"
  },
  "architecture": {
    "ANIL_X_is_the_only_main_site": true,
    "cityOfEternity_is_not_an_ANIL_X_runtime_module": true,
    "immortalGuard_is_inside_owner_console": true,
    "no_duplicate_guard_engines": true,
    "guardReceivingWallet": "MAIN_TREASURY"
  },
  "operating_rule": {
    "continueFromLatestCommit": true,
    "never_reset_to_baseline": true,
    "truth_over_claims": true,
    "every_change_requires_real_test_or_is_marked_unverified": true,
    "prefer_real_runtime_evidence_over_static_labels": true
  },
  "frontier_engine_rule": {
    "discover": "official/current sources only",
    "verify": "runtime smoke test before production routing",
    "score": [
      "capability",
      "latency",
      "reliability",
      "failureRate",
      "cost",
      "context",
      "multimodal"
    ],
    "route": "task-fit and health, not a hard-coded permanent winner",
    "learn": "record measured outcomes without exposing secrets",
    "improve": "safe incremental changes; never silently weaken security, payment, wallet or owner approval"
  },
  "security": {
    "privateKeysInGit": false,
    "seedPhrasesInGit": false,
    "automaticSigning": false,
    "automaticIrreversibleMoneyMovement": false,
    "ownerApprovalForIrreversibleActions": true,
    "adminPasswordSource": "Render environment secret ANIL_ADMIN_PASSWORD",
    "adminPasswordRequiredPattern": "^.{9}$",
    "walletSource": "Render environment secret TON_MAIN_WALLET",
    "walletMustBeValidatedAtRuntime": true,
    "temporaryGuardWalletSource": null,
    "temporaryGuardWalletMustBeDistinctFromMain": false,
    "guardPublicStateMustNeverContainMainWallet": true,
    "temporaryWalletUsed": false
  },
  "ownerRuntimeRequirements": {
    "TON_MAIN_WALLET": "SET_IN_RENDER_SECRET",
    "ANIL_ADMIN_PASSWORD": "SET_IN_RENDER_SECRET_AS_EXACT_OWNER_9_CHARACTERS",
    "neverCommitSecretValues": true
  },
  "completionStandard": {
    "noKnownPlaceholder": true,
    "noFabricatedModelNames": true,
    "noFakeRevenue": true,
    "noFakeLiveStatus": true,
    "noKnownUnwiredButton": true
  }
}
