{
  "version": 3,
  "purpose": "ANIL X is a provider-neutral AI operating system for website delivery, business growth, engineering, research, and Immortal Guard.",
  "strategy": "first-party multipurpose serial creation engine with domain-specialist routing, authorized tools, evidence verification, QA, recovery, rollback, and truthful live-state reporting",
  "providers": {
    "internal_engines": {
      "enabled": true,
      "roles": [
        "reasoning",
        "planning",
        "security",
        "code-quality-review",
        "research-routing",
        "payment-integrity",
        "revenue-operations",
        "guard-verification",
        "qa",
        "synthesis"
      ],
      "execution": "first-party deterministic engines and authorized tools"
    },
    "openai": {
      "optional": true,
      "enabled_when": "OPENAI_API_KEY with successful runtime invocation",
      "roles": [
        "advanced reasoning",
        "coding",
        "tool-use",
        "synthesis"
      ],
      "fallback": "first-party specialist engine chain"
    },
    "openai_compatible_router": {
      "optional": true,
      "enabled_when": "ANIL_OPENROUTER_API_KEY or OPENROUTER_API_KEY with successful runtime invocation",
      "roles": [
        "optional model routing"
      ],
      "fallback": "first-party specialist engine chain"
    },
    "github_actions": {
      "enabled_when": "authorized GitHub workflow",
      "roles": [
        "controlled repository execution",
        "CI/CD"
      ]
    },
    "mcp_tools": {
      "enabled_when": "tool connection configured",
      "roles": [
        "browser",
        "repository",
        "database",
        "search",
        "external services"
      ]
    }
  },
  "routing": {
    "default": [
      "intent-router",
      "ANIL Core Reasoning Engine",
      "security-gate",
      "evidence-verifier"
    ],
    "research": [
      "research-engine",
      "source-verification-engine",
      "evidence-merger"
    ],
    "hard_reasoning": [
      "problem-decomposition-engine",
      "reasoning-engine",
      "independent-qa-engine"
    ],
    "coding": [
      "code-architecture-engine",
      "implementation-planner",
      "code-quality-engine",
      "controlled-repository-tool"
    ],
    "verification": [
      "evidence-verification-engine",
      "regression-test-engine",
      "release-gate"
    ],
    "multimodal": [
      "vision-engine",
      "voice-engine"
    ],
    "browser": [
      "authorized-browser-tool",
      "evidence-ledger"
    ],
    "final_synthesis": [
      "ANIL Core Reasoning Engine",
      "truth-and-evidence-gate"
    ],
    "fallback": [
      "first-party specialist engine chain"
    ]
  },
  "agent_roles": [
    "orchestrator",
    "researcher",
    "architect",
    "coder",
    "reviewer",
    "security",
    "browser_tester",
    "growth",
    "ux",
    "guard_verifier",
    "release_manager"
  ],
  "engineering": {
    "discover": true,
    "plan": true,
    "edit": true,
    "test": true,
    "security_scan": true,
    "browser_verify": true,
    "performance_check": true,
    "accessibility_check": true,
    "review": true,
    "rollback": true,
    "change_scope": "one bounded change per autonomous cycle",
    "promotion": "controlled PR/review path"
  },
  "memory": {
    "session": true,
    "durable_when_database_configured": true,
    "sensitive_traits": false,
    "raw_prompts": false,
    "derived_state": true,
    "decision_log": true,
    "rollback_context": true
  },
  "observability": {
    "provider_health": true,
    "latency": true,
    "token_cost_when_available": true,
    "tool_failures": true,
    "change_audit": true,
    "live_truth_checks": true
  },
  "continuous_improvement": {
    "site_radar": "hourly",
    "guard_radar": "hourly",
    "no_op_if_no_safe_meaningful_change": true,
    "evaluate_before_promote": true
  },
  "truth_policy": {
    "provider_is_live_only_after_successful_runtime_check": true,
    "never_claim_unconfigured_provider": true,
    "never_claim_tests_without_running_them": true,
    "actual_revenue_only_from_settled_verified_payment": true
  },
  "safety": {
    "secret_storage": false,
    "seed_or_private_key": false,
    "wallet_signing": false,
    "automatic_fund_transfer": false,
    "payment_execution": false,
    "kyc_or_captcha_bypass": false,
    "security_controls_may_not_be_weakened": true,
    "spam": false
  },
  "engine_chain": {
    "name": "ANIL-MULTIPURPOSE-SERIAL-CREATION-ENGINE",
    "version": "4.0.0",
    "mode": "serial-first-with-parallel-independent-checks-when-useful",
    "stages": [
      "sense",
      "understand",
      "intent-and-priority",
      "decompose",
      "select-domain-engines",
      "create-or-repair",
      "security-and-owner-gate",
      "execute-authorized-tools",
      "self-repair",
      "qa-and-regression",
      "evidence-and-truth-verification",
      "release-gate",
      "observe",
      "learn"
    ],
    "capabilities": [
      "software-and-web-app-creation",
      "code-repair",
      "research-and-verification",
      "business-and-revenue-operations",
      "security",
      "payments-integrity",
      "workflow-automation",
      "content-and-product-creation",
      "data-analysis",
      "mobile-ux",
      "guard-opportunity-verification"
    ],
    "rules": {
      "externalModelsAreOptionalAdapters": true,
      "threeModelCouncil": false,
      "executionMustBeToolBacked": true,
      "completionRequiresEvidence": true,
      "failedChecksBlockRelease": true,
      "sensitiveActionsRequireOwnerApproval": true,
      "privateKeysAndSeedPhrasesNeverRequested": true
    }
  }
}
