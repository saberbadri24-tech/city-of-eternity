{
  "schemaVersion": 2,
  "name": "ANIL X Independent Engine Control Plane",
  "purpose": "Route tasks through first-party specialist engines, bounded tools, live evidence and independent verification.",
  "principles": [
    "Prefer runtime evidence over labels or benchmark claims.",
    "No external model is required for the core reasoning chain.",
    "Fail closed when evidence is stale or unavailable.",
    "Never claim execution without tool confirmation.",
    "Do not weaken payment, security or wallet approval boundaries."
  ],
  "engineCatalog": {
    "reasoning": {
      "module": "functions/api/anil-engine-chain.mjs",
      "role": "problem decomposition and plan"
    },
    "planning": {
      "module": "functions/api/plan.mjs",
      "role": "intent routing and research"
    },
    "security": {
      "module": "functions/api/guard-live.mjs",
      "role": "security and opportunity gate"
    },
    "verification": {
      "module": "functions/api/execution-readiness.mjs",
      "role": "runtime evidence and readiness"
    },
    "superTeam": {
      "module": "functions/api/anil-super-team.mjs",
      "role": "independent engine coordination"
    },
    "paymentIntegrity": {
      "module": "functions/api/pay.js",
      "role": "checkout integrity and order binding"
    },
    "revenue": {
      "module": "worker.js",
      "role": "revenue operations and settlement truth"
    },
    "quality": {
      "module": "scripts/verify-anil-engine-chain.mjs",
      "role": "regression and engine-chain verification"
    }
  },
  "selection": {
    "dimensions": [
      "task_capability",
      "runtime_health",
      "evidence_quality",
      "latency",
      "safe_tool_availability"
    ],
    "minimumEvidence": "successful runtime smoke test",
    "tieBreak": "lowest observed failure rate after capability requirements are satisfied"
  },
  "safeFallback": {
    "deterministicEngines": true,
    "singleProviderModeAllowed": true,
    "unavailableToolsExcluded": true,
    "noFakeCapability": true,
    "externalModelCallsOptional": true
  }
}
