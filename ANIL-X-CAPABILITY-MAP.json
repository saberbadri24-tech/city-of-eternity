{
  "version":2,
  "purpose":"Exact capability contract for the ANIL X site assistant.",
  "tools":{
    "url_fetch":{"live":true,"scope":"public URLs only","private_network":false},
    "github":{"live_when":"GITHUB_TOKEN configured","scope":"environment credential"},
    "browser":{"live":"Playwright smoke via GitHub Actions","interactive_browser":"credential required"},
    "memory":{"live":true,"scope":"session working memory"},
    "vision":{"live_when":"client TensorFlow model loads"},
    "voice":{"live_when":"browser speech APIs available"},
    "render":{"live_when":"RENDER_API_KEY configured"},
    "payments":{"live_when":"real provider credentials configured"}
  },
  "automation":"discover -> reason -> tool -> verify -> propose/change -> test -> deploy -> observe",
  "truthRule":"Never report a capability as live without a successful real check.",
  "safety":{"secrets":"environment_only","irreversible":"owner_approval","credential_bypass":false,"seed_or_private_key":false,"spam":false}
}
